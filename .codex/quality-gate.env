# Project bootstrap should replace empty commands with commands that exist in THIS repository.
# Do not invent scripts that the project does not have.
#
# Keep secrets out of this file.

FORMAT_CHECK_CMD=""
LINT_CMD=""
TYPECHECK_CMD=""
BUILD_CMD=""
UNIT_TEST_CMD=""
INTEGRATION_TEST_CMD=""
# Optional: only set when the repository has a distinct regression suite; avoid duplicating UNIT/INTEGRATION/E2E.
REGRESSION_TEST_CMD=""
E2E_TEST_CMD=""
SECURITY_SCAN_CMD=""

# If true, quality-gate fails when no test command is configured.
REQUIRE_TESTS=true

# Keep agent/tool output compact while preserving failure context.
QUALITY_GATE_FAILURE_TAIL_LINES=120
