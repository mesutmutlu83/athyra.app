# High-impact commands should always surface for explicit approval.
# Codex Rules are an additional guardrail, not a replacement for CI or access control.

prefix_rule(
    pattern = ["git", "push"],
    decision = "prompt",
    justification = "Pushing changes is an external side effect; review the branch and quality-gate status first.",
    match = ["git push", "git push origin feature/example"],
)

prefix_rule(
    pattern = ["git", "reset", "--hard"],
    decision = "prompt",
    justification = "Hard reset can destroy local work. Confirm explicitly before proceeding.",
    match = ["git reset --hard", "git reset --hard HEAD~1"],
)

prefix_rule(
    pattern = ["git", "clean"],
    decision = "prompt",
    justification = "git clean may permanently delete untracked work. Confirm explicitly before proceeding.",
    match = ["git clean -fd", "git clean -fdx"],
)

prefix_rule(
    pattern = ["npm", "publish"],
    decision = "prompt",
    justification = "Package publication is an external release action.",
    match = ["npm publish", "npm publish --access public"],
)

prefix_rule(
    pattern = ["docker", "push"],
    decision = "prompt",
    justification = "Pushing an image changes an external registry.",
    match = ["docker push example/app:latest"],
)

prefix_rule(
    pattern = ["kubectl", "delete"],
    decision = "prompt",
    justification = "Kubernetes delete may be destructive.",
    match = ["kubectl delete pod example", "kubectl delete namespace example"],
)

prefix_rule(
    pattern = ["terraform", "apply"],
    decision = "prompt",
    justification = "Terraform apply can materially change infrastructure.",
    match = ["terraform apply", "terraform apply tfplan"],
)
